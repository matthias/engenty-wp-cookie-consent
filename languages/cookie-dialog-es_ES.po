#. Description of the plugin
#: cookie-dialog.php
msgid "A simple, beautiful cookie dialog for the EU: categories and services, scripts and embeds only after consent, a consent log, Google Consent Mode v2 – and an assistant that sets it up."
msgstr "Un diálogo de cookies sencillo y bonito para la UE: categorías y servicios, scripts e incrustaciones solo tras el consentimiento, un registro de consentimientos, Google Consent Mode v2 – y un asistente que lo configura."

