#. Plugin Name of the plugin
#: cookie-dialog.php
#: includes/class-admin.php:202
msgid "Cookie Dialog"
msgstr "Cookie Dialog"

#. Description of the plugin
#: cookie-dialog.php
msgid "A simple, beautiful cookie dialog for the EU: categories and services, scripts and embeds only after consent, a consent log, Google Consent Mode v2 – and an assistant that sets it up."
msgstr "Een eenvoudige, mooie cookiedialoog voor de EU: categorieën en diensten, scripts en insluitingen pas na toestemming, een toestemmingslogboek, Google Consent Mode v2 – en een assistent die het instelt."

