#. Plugin Name of the plugin
#: cookie-dialog.php
#: includes/class-admin.php:202
msgid "Cookie Dialog"
msgstr "Cookie Dialog"

#. Description of the plugin
#: cookie-dialog.php
msgid "A simple, beautiful cookie dialog for the EU: categories and services, scripts and embeds only after consent, a consent log, Google Consent Mode v2 – and an assistant that sets it up."
msgstr "Um diálogo de cookies simples e bonito para a UE: categorias e serviços, scripts e incorporações só após consentimento, um registo de consentimentos, Google Consent Mode v2 – e um assistente que o configura."

