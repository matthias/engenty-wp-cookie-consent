#: includes/class-admin.php:206
msgid "Cookie Dialog"
msgstr "Cookie Dialog"

#. Description of the plugin
#: cookie-dialog.php
msgid "A simple, beautiful cookie dialog for the EU: categories and services, scripts and embeds only after consent, a consent log, Google Consent Mode v2 – and an assistant that sets it up."
msgstr "Un dialogue cookies simple et élégant pour l’UE : catégories et services, scripts et contenus embarqués seulement après consentement, un journal des consentements, Google Consent Mode v2 – et un assistant qui le configure."

