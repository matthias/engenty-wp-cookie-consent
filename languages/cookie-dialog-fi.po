#. Plugin Name of the plugin
#: cookie-dialog.php
#: includes/class-admin.php:202
msgid "Cookie Dialog"
msgstr "Cookie Dialog"

#. Description of the plugin
#: cookie-dialog.php
msgid "A simple, beautiful cookie dialog for the EU: categories and services, scripts and embeds only after consent, a consent log, Google Consent Mode v2 – and an assistant that sets it up."
msgstr "Yksinkertainen, kaunis evästedialogi EU:hun: kategoriat ja palvelut, skriptit ja upotukset vasta suostumuksen jälkeen, suostumusloki, Googlen Consent Mode v2 – ja avustaja, joka tekee asetukset."

